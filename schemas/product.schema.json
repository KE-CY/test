{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://104.com.tw/schemas/ha-ext-gw/product.schema.json",
  "title": "HA External Gateway Product",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "owner", "base_path", "scopes"],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{4}$"
    },
    "owner": {
      "type": "string",
      "format": "email"
    },
    "base_path": {
      "type": "string",
      "pattern": "^/[a-z][a-z0-9-]*$"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "description"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
