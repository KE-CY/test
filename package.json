{
  "name": "ha-ext-gw-config-test",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "validate:registry": "node scripts/validate.mjs",
    "validate:openapi": "redocly lint \"products/**/openapi.yaml\" --extends=spec",
